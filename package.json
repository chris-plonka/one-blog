    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "knip": "^5.88.1",
    "lefthook": "^2.1.8",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
